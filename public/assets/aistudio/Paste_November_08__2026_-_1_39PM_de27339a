<!-- Script for Tab Switching & Interactivity -->
<script>
        function switchTab(tabName, btnElement) {
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(el => {
                el.classList.add('hidden');
            });
            // Show target tab
            const target = document.getElementById('view-' + tabName);
            if (target) {
                target.classList.remove('hidden');
            }
            // Update active states on sidebar buttons if triggered from sidebar
            if (btnElement) {
                document.querySelectorAll('.nav-links button').forEach(btn => {
                    btn.className = "flex items-center gap-3 w-full text-left text-on-surface-variant rounded-lg px-space-md py-space-sm hover:bg-surface-container-high hover:text-on-surface transition-all duration-150";
                });
                btnElement.className = "flex items-center gap-3 w-full text-left bg-primary-container/20 text-primary font-bold rounded-lg px-space-md py-space-sm transition-all duration-150";
            } else {
                // If triggered programmatically, find matching button
                document.querySelectorAll('.nav-links button').forEach(btn => {
                    if (btn.textContent.trim().includes(tabName)) {
                        btn.className = "flex items-center gap-3 w-full text-left bg-primary-container/20 text-primary font-bold rounded-lg px-space-md py-space-sm transition-all duration-150";
                    } else {
                        btn.className = "flex items-center gap-3 w-full text-left text-on-surface-variant rounded-lg px-space-md py-space-sm hover:bg-surface-container-high hover:text-on-surface transition-all duration-150";
                    }
                });
            }
            // Scroll canvas to top
            document.getElementById('main-canvas').scrollTop = 0;
        }

        function openModal() {
            document.getElementById('new-batch-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('new-batch-modal').classList.add('hidden');
        }

        function simulateUpload() {
            alert('Simulating file upload and pipeline initialization...');
            switchTab('Dashboard', document.querySelector('.nav-links button:nth-child(1)'));
        }

        let isPlaying = false;
        function togglePlay() {
            isPlaying = !isPlaying;
            const btn = document.getElementById('play-btn');
            if (isPlaying) {
                btn.innerHTML = '<span class="material-symbols-outlined text-2xl" style="font-variation-settings: \'FILL\' 1;">pause</span>';
            } else {
                btn.innerHTML = '<span class="material-symbols-outlined text-2xl" style="font-variation-settings: \'FILL\' 1;">play_arrow</span>';
            }
        }
    </script>
